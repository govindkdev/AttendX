# AttendX Environment Configuration Example
# Copy this file to .env in backend/ or root and fill in required values

# Database Configuration (PostgreSQL recommended for production, SQLite supported for development)
# Example PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/attendx
# Example SQLite dev: sqlite+aiosqlite:///./attendx.db
DATABASE_URL=sqlite+aiosqlite:///./attendx.db

# Application & Security Secrets
APP_SECRET_KEY=attendx_app_super_secret_development_key_change_in_production_32bytes
JWT_SECRET_KEY=attendx_jwt_secure_signing_secret_key_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# URLs and CORS
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000

# Institute Defaults
INSTITUTE_NAME=GCRG Group of Institutions
INSTITUTE_LOCATION=Lucknow, Uttar Pradesh, India
INSTITUTE_TIMEZONE=Asia/Kolkata

# Initial Administrator Provisioning (Use scripts/provision_admin.py or environment variables)
INITIAL_ADMIN_ID=ADM-001
INITIAL_ADMIN_NAME=Govind Kushwaha
INITIAL_ADMIN_PASSWORD=

# Email Provider Configuration (smtp / mock / sendgrid)
EMAIL_PROVIDER=mock
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=notifications@gcrg.edu.in

# SMS Provider Configuration (twilio / mock / fast2sms)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=ATTNDX

# AI Assistant Configuration (rule_based / gemini / openai)
AI_PROVIDER=rule_based
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Computer Vision & Storage
FACE_MODEL_PATH=storage/models
UPLOAD_STORAGE_PATH=storage/uploads

# GPS Geofence Configuration (Configured by admin; defaults for GCRG Campus, Lucknow)
INSTITUTE_LATITUDE=26.8467
INSTITUTE_LONGITUDE=80.9462
GEOFENCE_RADIUS_METERS=200
GEOFENCE_ACCURACY_THRESHOLD=50
